\u0440\u0435\u0444\u043e\u0440\u043c\u044b  </li> <li>\u0421\u043e\u0441\u043b\u043e\u0432\u043d\u0430\u044f \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430  </li> <li>\u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u044b  </li> </ul>"},{"location":"catherine/reforms/#_3","title":"\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435","text":"<p>\u0417\u0434\u0435\u0441\u044c \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u0440\u0435\u0444\u043e\u0440\u043c.</p>"},{"location":"catherine/turning_1789/","title":"\u041f\u0435\u0440\u0435\u043b\u043e\u043c 1789 \u0433.","text":"<p>\u0421\u043e\u0431\u044b\u0442\u0438\u044f \u043a\u043e\u043d\u0446\u0430 XVIII \u0432\u0435\u043a\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0438 \u043d\u0430 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u0443\u0440\u0441 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u044b II.</p>"},{"location":"catherine/turning_1789/#_1","title":"\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f","text":"<ul> <li>\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043a \u0438\u0434\u0435\u044f\u043c \u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f  </li> <li>\u0423\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f  </li> <li>\u041e\u0442\u043a\u0430\u0437 \u043e\u0442 \u0447\u0430\u0441\u0442\u0438 \u043b\u0438\u0431\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432  </li> </ul>"},{"location":"catherine/turning_1789/#_2","title":"\u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442","text":"<p>\u0424\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0430\u044f \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0432\u044b\u0437\u0432\u0430\u043b\u0430 \u043e\u043f\u0430\u0441\u0435\u043d\u0438\u044f \u0443 \u043f\u0440\u0430\u0432\u044f\u0449\u0438\u0445 \u043a\u0440\u0443\u0433\u043e\u0432 \u0415\u0432\u0440\u043e\u043f\u044b \u0438 \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0430 \u043d\u0430 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u044e\u044e \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0443 \u0420\u043e\u0441\u0441\u0438\u0438.</p>"},{"location":"catherine/turning_1789/#_3","title":"\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435","text":"<p>\u0420\u0430\u0437\u0434\u0435\u043b \u0431\u0443\u0434\u0435\u0442 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d \u0430\u043d\u0430\u043b\u0438\u0437\u043e\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0439 \u044d\u0442\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043b\u043e\u043c\u0430.</p>"},{"location":"coups/","title":"\u042d\u043f\u043e\u0445\u0430 \u0434\u0432\u043e\u0440\u0446\u043e\u0432\u044b\u0445 \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u043e\u0442\u043e\u0432","text":"<p>\u041f\u0435\u0440\u0438\u043e\u0434 XVIII \u0432\u0435\u043a\u0430, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u044e\u0449\u0438\u0439\u0441\u044f \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e \u0438 \u0431\u043e\u0440\u044c\u0431\u043e\u0439 \u0437\u0430 \u0432\u043b\u0430\u0441\u0442\u044c.</p>"},{"location":"coups/#_2","title":"\u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u043a \u0440\u0430\u0437\u0434\u0435\u043b\u0443","text":"<ul> <li>\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441\u0438\u0441\u0442\u0435\u043c\u044b</li> </ul>"},{"location":"coups/problmes/","title":"\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441\u0438\u0441\u0442\u0435\u043c\u044b","text":"<ul> <li>\u041a\u0440\u0438\u0437\u0438\u0441 \u043f\u0440\u0435\u0441\u0442\u043e\u043b\u043e\u043d\u0430\u0441\u043b\u0435\u0434\u0438\u044f  </li> <li>\u041f\u043e\u043b\u0438\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u0433\u0432\u0430\u0440\u0434\u0438\u0438  </li> <li>\u0411\u044e\u0440\u043e\u043a\u0440\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f  </li> <li>\u041a\u0440\u0438\u0437\u0438\u0441 \u043b\u0435\u0433\u0438\u0442\u0438\u043c\u043d\u043e\u0441\u0442\u0438 </li> </ul>"},{"location":"enlightenment/","title":"\u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0451\u043d\u043d\u044b\u0439 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u0438\u0437\u043c","text":"<p>\u041c\u043e\u0434\u0435\u043b\u044c \u0432\u043b\u0430\u0441\u0442\u0438, \u0441\u043e\u0447\u0435\u0442\u0430\u044e\u0449\u0430\u044f \u0438\u0434\u0435\u0438 \u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u0441 \u0441\u0438\u043b\u044c\u043d\u043e\u0439 \u043c\u043e\u043d\u0430\u0440\u0445\u0438\u0435\u0439.</p>"},{"location":"enlightenment/#_2","title":"\u041f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u044b","text":"<ul> <li>\u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435</li> <li>\u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438</li> </ul>"},{"location":"enlightenment/european/","title":"\u0415\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435","text":"<p>\u0418\u0434\u0435\u0438 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u043e\u0433\u043e \u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u044f \u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0432\u043b\u0438\u044f\u043d\u0438\u0435 \u043d\u0430 \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u0437\u0433\u043b\u044f\u0434\u043e\u0432 \u043c\u043e\u043d\u0430\u0440\u0445\u043e\u0432 XVIII \u0432\u0435\u043a\u0430.</p>"},{"location":"enlightenment/european/#_2","title":"\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f","text":"<ul> <li>\u0412\u043b\u0438\u044f\u043d\u0438\u0435 \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u043e\u0432 (\u0412\u043e\u043b\u044c\u0442\u0435\u0440, \u0414\u0438\u0434\u0440\u043e)  </li> <li>\u0418\u0434\u0435\u044f \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043e\u043c  </li> <li>\u0417\u0430\u0438\u043c\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439  </li> </ul>"},{"location":"enlightenment/european/#_3","title":"\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435","text":"<p>\u0414\u0430\u043d\u043d\u044b\u0439 \u0440\u0430\u0437\u0434\u0435\u043b \u0431\u0443\u0434\u0435\u0442 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d \u0430\u043d\u0430\u043b\u0438\u0437\u043e\u043c \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0445 \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432.</p>"},{"location":"enlightenment/russia/","title":"\u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438","text":"<p>\u041f\u0440\u043e\u0441\u0432\u0435\u0449\u0451\u043d\u043d\u044b\u0439 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u0438\u0437\u043c \u0432 \u0420\u043e\u0441\u0441\u0438\u0438 \u0438\u043c\u0435\u043b \u0440\u044f\u0434 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0447\u0435\u0440\u0442, \u043e\u0431\u0443\u0441\u043b\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u043c\u0438 \u0441\u0442\u0440\u0430\u043d\u044b.</p>"},{"location":"enlightenment/russia/#_2","title":"\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438","text":"<ul> <li>\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0441\u0430\u043c\u043e\u0434\u0435\u0440\u0436\u0430\u0432\u0438\u044f  </li> <li>\u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u043a\u0440\u0435\u043f\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430  </li> <li>\u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0444\u043e\u0440\u043c  </li> </ul>"},{"location":"enlightenment/russia/#_3","title":"\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435","text":"<p>\u0420\u0430\u0437\u0434\u0435\u043b \u0431\u0443\u0434\u0435\u0442 \u0434\u043e\u043f\u043e\u043b\u043d\u0435\u043d \u043f\u0440\u0438\u043c\u0435\u0440\u0430\u043c\u0438 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0438 \u0432 \u0420\u043e\u0441\u0441\u0438\u0438.</p>"}]}